# Edge Function secrets. NEVER commit real values. Set them with:
#   supabase secrets set --env-file backend/supabase/functions/.env     (your private copy)
# or one at a time:  supabase secrets set NAME=value
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# AamarPay. Sandbox store id and signature key are published in AamarPay's own sandbox docs;
# for production use your live merchant credentials and AAMARPAY_BASE_URL=https://secure.aamarpay.com
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com
AAMARPAY_STORE_ID=<your store id>
AAMARPAY_SIGNATURE_KEY=<your signature key>

# Cloudinary (rotate the API secret that was pasted into a chat before using this)
CLOUDINARY_CLOUD_NAME=hmpqmney
CLOUDINARY_API_KEY=<cloudinary api key>
CLOUDINARY_API_SECRET=<cloudinary api secret>

# Lets a scheduler call cloudinary-cleanup without an admin login (generate a long random string)
CRON_SECRET=<random string>

# Optional: where the browser is sent after paying (https page or app deep link)
# PAYMENT_RETURN_URL=io.supabase.toptailers://payment-result
